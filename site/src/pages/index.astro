---
import { getCollection } from 'astro:content';
import EntryCard from '../components/EntryCard.astro';
import WordCloud from '../components/WordCloud.astro';
import ActivityGrid from '../components/ActivityGrid.astro';

const allEntries = await getCollection('entries');
const sorted = allEntries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const tagCounts: Record<string, number> = {};
for (const entry of allEntries) {
  for (const tag of entry.data.tags) {
    tagCounts[tag] = (tagCounts[tag] ?? 0) + 1;
  }
}
const tags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>study-log | matt</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    <main>
      <header class="site-header">
        <div class="prompt-line"><span class="prompt-mark">&gt;</span><span class="cmd"> cat README.md</span></div>
        <div class="readme-box">
          <p class="readme-title"># study-log</p>
          <p>Hi. I'm Matt. This is my study log while preparing for my next hacker role.</p>
        </div>
      </header>

      <section class="section">
        <div class="prompt-line"><span class="prompt-mark">&gt;</span><span class="cmd"> study-log --activity --months=6</span></div>
        <ActivityGrid entries={allEntries} monthsBack={3} monthsForward={2} />
      </section>

      <section class="section">
        <div class="prompt-line"><span class="prompt-mark">&gt;</span><span class="cmd"> git log --oneline</span></div>
        <div class="keyhint">
          <span class="keyhint-key">j/k</span> up/down
          <span class="keyhint-sep">·</span>
          <span class="keyhint-key">Enter</span> select
          <span class="keyhint-sep">·</span>
          <span class="keyhint-key">gg/G</span> first/last
          <span class="keyhint-sep">·</span>
          <span class="keyhint-key">/</span> filter
        </div>
        <div class="entry-search" id="entry-search" hidden>
          <span class="search-mark">/</span>
          <input
            type="text"
            id="entry-search-input"
            class="entry-search-input"
            placeholder="filter by title or tag…"
            autocomplete="off"
            spellcheck="false"
          />
          <span class="search-count" id="entry-search-count"></span>
        </div>
        <div class="entry-list" id="entry-list">
          {sorted.map((entry) => <EntryCard entry={entry} />)}
          <div class="entry-empty" id="entry-empty" hidden>no matches</div>
        </div>
      </section>

      <section class="section">
        <div class="prompt-line"><span class="prompt-mark">&gt;</span><span class="cmd"> study-log --list-topics</span></div>
        <WordCloud tags={tags} />
      </section>
    </main>

    <script is:inline src="/scripts/vim-nav.js"></script>
  </body>
</html>
